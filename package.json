{
  "name": "judge-jev",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare:data": "node --experimental-strip-types src/cli.ts prepare",
    "infer": "node --experimental-strip-types src/cli.ts infer",
    "calibrate": "node --experimental-strip-types src/cli.ts calibrate",
    "evaluate": "node --experimental-strip-types src/cli.ts evaluate",
    "status": "node --experimental-strip-types src/cli.ts status",
    "site:dev": "node site/scripts/prepare-downloads.mjs && ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "site:build": "node site/scripts/prepare-downloads.mjs && ASTRO_TELEMETRY_DISABLED=1 astro build",
    "site:preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "check": "tsc --noEmit && ASTRO_TELEMETRY_DISABLED=1 astro check",
    "test": "node --experimental-strip-types --test test/*.test.ts"
  },
  "dependencies": {
    "@astrojs/react": "^7.0.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@typesafe-ai/sdk": "0.6.0",
    "astro": "^7.3.5",
    "clsx": "^2.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.0"
  }
}
